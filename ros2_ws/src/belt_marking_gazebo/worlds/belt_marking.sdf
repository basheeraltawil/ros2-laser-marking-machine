<?xml version="1.0"?>
<sdf version="1.8">
  <world name="belt_marking">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <ignition-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property></ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.75 0.8 0.85</background_color>
        <camera_pose>1.1 -0.9 0.9 0 0.45 2.45</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui><title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/>
            <line own="bottom" target="bottom"/></anchors></ignition-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="ImageDisplay" name="QA camera">
        <ignition-gui><title>QA camera</title>
          <property key="state" type="string">docked</property></ignition-gui>
        <topic>qa_camera/image_raw</topic>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>
    <light type="point" name="work_light">
      <pose>0.05 -0.2 0.9 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <attenuation><range>3</range><constant>0.5</constant><linear>0.1</linear></attenuation>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>6 6</size></plane>
          </geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>6 6</size></plane>
          </geometry><material><ambient>0.55 0.55 0.52 1</ambient>
          <diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
      </link>
    </model>
    <!-- fixed overview camera for documentation / remote viewing (/overview/image) -->
    <model name="overview_camera">
      <static>true</static>
      <pose>0.75 -0.75 0.85 0 0.52 2.36</pose>
      <link name="link">
        <sensor name="overview" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>overview/image</topic>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>1280</width><height>800</height></image>
            <clip><near>0.05</near><far>10</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
